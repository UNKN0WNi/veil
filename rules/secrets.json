{
  "version": 1,
  "rules_version": "2026.11.1",
  "_comment": "凭据与密钥：AWS / GitHub / 私钥 / 通用 API key。正则用 lexmatch 方言。",
  "defaults": { "action": "redact", "censor": "[REDACTED]", "min_score": 0.5 },
  "detectors": [
    {
      "id": "aws_access_key",
      "description": "AWS Access Key ID（AKIA/ASIA + 16 位大写字母数字）。误报：产品序列号。",
      "type": "pattern",
      "pattern": "(AKIA|ASIA)[0-9A-Z]{16}",
      "score": 0.95
    },
    {
      "id": "github_token",
      "description": "GitHub Personal Access Token（ghp_/gho_/ghu_/ghs_/ghr_ 前缀）。",
      "type": "pattern",
      "pattern": "gh[pousr]_[A-Za-z0-9]{36}",
      "score": 0.95
    },
    {
      "id": "private_key",
      "description": "PEM 私钥头。命中后整段标记（文本轨标记头部字符串）。",
      "type": "pattern",
      "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "score": 0.95
    },
    {
      "id": "slack_token",
      "description": "Slack API token（xox[baprs]- 前缀）。",
      "type": "pattern",
      "pattern": "xox[baprs]-[A-Za-z0-9\\-]{10,}",
      "score": 0.9
    },
    {
      "id": "generic_api_key",
      "description": "通用 api_key/secret 赋值。靠上下文词提分，避免误伤普通变量。",
      "type": "pattern",
      "pattern": "[A-Za-z0-9_\\-]{20,}",
      "score": 0.3,
      "context": {
        "words": ["api_key", "apikey", "secret", "token", "password", "passwd", "凭证", "密钥"],
        "window": 24,
        "boost": 0.5,
        "case_sensitive": false
      }
    }
  ],
  "operators": [
    { "id": "default", "type": "redact" },
    { "id": "stable_hash", "type": "hash", "algo": "hmac_sha256", "prefix": "h_", "length": 12 }
  ],
  "policy": { "mode": "allow_by_default", "allow_paths": [], "ignore_paths": [] },
  "formats": ["json", "logfmt", "plain"]
}
