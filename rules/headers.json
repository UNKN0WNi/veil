{
  "version": 1,
  "rules_version": "2026.11.1",
  "_comment": "HTTP 敏感头与字段路径。field 类型按路径定位，不跑正则（最快）。",
  "defaults": { "action": "redact", "censor": "[REDACTED]", "min_score": 0.5 },
  "detectors": [
    {
      "id": "sensitive_headers",
      "description": "HTTP 敏感请求头：Authorization / Cookie / Set-Cookie / X-Api-Key。",
      "type": "field",
      "targets": [
        "http.request.header.authorization",
        "http.request.header.cookie",
        "http.request.header.set-cookie",
        "http.request.header.x-api-key"
      ],
      "action": "redact"
    },
    {
      "id": "secret_fields",
      "description": "常见密钥字段名。命中字段路径后整值脱敏。",
      "type": "field",
      "targets": [
        "*.password", "*.passwd", "*.secret", "*.token", "*.api_key", "*.access_key"
      ],
      "action": "redact"
    }
  ],
  "operators": [
    { "id": "default", "type": "redact" }
  ],
  "policy": { "mode": "allow_by_default", "allow_paths": [], "ignore_paths": [] },
  "formats": ["http_headers", "json"]
}
