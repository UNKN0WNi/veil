{
  "version": 1,
  "rules_version": "2026.11.1",
  "_comment": "中国大陆实体：身份证 / 手机号 / 银行卡 / 统一社会信用代码。正则用 lexmatch 方言。",
  "defaults": { "action": "redact", "censor": "[REDACTED]", "min_score": 0.5 },
  "detectors": [
    {
      "id": "cn_id_card",
      "description": "中国大陆居民身份证号。GB 11643 加权校验位，误报率极低。",
      "type": "pattern",
      "pattern": "[1-9][0-9]{5}(19|20)[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx]",
      "validator": "cn_id_checksum",
      "score": 0.95
    },
    {
      "id": "cn_phone",
      "description": "中国大陆手机号。裸数字歧义大（可能是订单号），基线分低，靠上下文词提分。",
      "type": "pattern",
      "pattern": "1[3-9][0-9]{9}",
      "score": 0.35,
      "context": {
        "words": ["手机", "电话", "联系方式", "联系电话", "phone", "tel", "mobile"],
        "window": 24,
        "boost": 0.45,
        "case_sensitive": false
      }
    },
    {
      "id": "cn_bank_card",
      "description": "中国大陆银行卡号（16-19 位）。Luhn 校验过滤，避免 16 位订单号误报。",
      "type": "pattern",
      "pattern": "[0-9]{16,19}",
      "validator": "cn_bank_card_checksum",
      "score": 0.9
    },
    {
      "id": "cn_uscc",
      "description": "统一社会信用代码（18 位）。GB 32100 字符加权校验。",
      "type": "pattern",
      "pattern": "[0-9A-HJ-NPQRTUWXY]{18}",
      "validator": "cn_uscc_checksum",
      "score": 0.85
    }
  ],
  "operators": [
    { "id": "default", "type": "redact" },
    { "id": "keep_last4", "type": "mask", "keep": { "prefix": 0, "suffix": 4 }, "fill": "*" }
  ],
  "policy": { "mode": "allow_by_default", "allow_paths": [], "ignore_paths": [] },
  "formats": ["json", "logfmt", "plain"]
}
