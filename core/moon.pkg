// core：后端无关内核。依赖 moonbitlang/core + moonbitlang/x/crypto（均为纯 MoonBit、
// 四后端一致），不依赖任何平台相关库（计划书 §7.4 的实质是"后端无关"）。
import {
  "moonbitlang/x/crypto",
  "moonbitlang/x/encoding",
  "moonbitlang/core/builtin",
  "moonbitlang/core/string",
  "moonbitlang/core/json",
  "moonbitlang/core/int",
  "moonbitlang/core/char",
  "moonbitlang/core/array",
  "moonbitlang/core/buffer",
  "moonbitlang/core/option",
  "moonbitlang/core/result",
  "moonbitlang/core/list",
}

import {
  "moonbitlang/core/test",
} for "test"
