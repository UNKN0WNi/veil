{
  "version": 1,
  "spec_version": "2026.11.1",
  "_comment": "跨语言/跨后端黄金用例。key 固定；expected_output 为精确字节。任何实现须逐字节一致。UTF-8 编码用于所有哈希。",
  "cases": [
    {
      "id": "email_redact",
      "description": "邮箱整体脱敏，默认 redact 算子",
      "input": "contact a@b.com now",
      "key": "",
      "ruleset": {
        "version": 1, "rules_version": "golden.1",
        "defaults": { "action": "redact", "censor": "[REDACTED]", "min_score": 0.5 },
        "detectors": [{ "id": "email", "description": "email", "type": "pattern", "pattern": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}", "score": 0.9 }],
        "operators": [{ "id": "default", "type": "redact" }]
      },
      "expected_output": "contact [REDACTED] now",
      "expected_matches": [{ "entity": "email", "operator": "redact", "start": 8, "end": 15 }]
    },
    {
      "id": "email_mask",
      "description": "邮箱保留首字符，其余遮蔽",
      "input": "user alice@example.com here",
      "key": "",
      "ruleset": {
        "version": 1, "rules_version": "golden.1",
        "defaults": { "action": "mask_email", "censor": "[REDACTED]", "min_score": 0.5 },
        "detectors": [{ "id": "email", "description": "email", "type": "pattern", "pattern": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}", "score": 0.9 }],
        "operators": [{ "id": "mask_email", "type": "mask", "keep": { "prefix": 1, "suffix": 0 }, "fill": "*" }]
      },
      "expected_output": "user a**************** here",
      "expected_matches": [{ "entity": "email", "operator": "mask", "start": 5, "end": 21 }]
    },
    {
      "id": "email_hash_hmac",
      "description": "邮箱 HMAC 假名化（固定密钥向量，UTF-8）",
      "input": "a@b.com",
      "key": "secret-key",
      "ruleset": {
        "version": 1, "rules_version": "golden.1",
        "defaults": { "action": "stable_hash", "censor": "[REDACTED]", "min_score": 0.5 },
        "detectors": [{ "id": "email", "description": "email", "type": "pattern", "pattern": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}", "score": 0.9 }],
        "operators": [{ "id": "stable_hash", "type": "hash", "algo": "hmac_sha256", "prefix": "h_", "length": 12 }]
      },
      "expected_output": "h_b64753dbe347",
      "expected_matches": [{ "entity": "email", "operator": "hash", "start": 0, "end": 7 }],
      "_note": "h_b64753dbe347 = HMAC-SHA256(secret-key, a@b.com)[:12]，Python/Node/MoonBit 三方一致"
    },
    {
      "id": "cn_phone_context",
      "description": "手机号靠上下文词提分（有'手机'才脱敏）",
      "input": "手机: 13800138000",
      "key": "",
      "ruleset": {
        "version": 1, "rules_version": "golden.1",
        "defaults": { "action": "redact", "censor": "[REDACTED]", "min_score": 0.5 },
        "detectors": [{ "id": "cn_phone", "description": "phone", "type": "pattern", "pattern": "1[3-9][0-9]{9}", "score": 0.35, "context": { "words": ["手机", "电话"], "window": 24, "boost": 0.45, "case_sensitive": false } }],
        "operators": [{ "id": "default", "type": "redact" }]
      },
      "expected_output": "手机: [REDACTED]",
      "expected_matches": [{ "entity": "cn_phone", "operator": "redact" }]
    },
    {
      "id": "cn_id_card_checksum",
      "description": "身份证校验和通过才脱敏；伪造校验位不命中",
      "input": "id 11010519491231002X ok",
      "key": "",
      "ruleset": {
        "version": 1, "rules_version": "golden.1",
        "defaults": { "action": "redact", "censor": "[REDACTED]", "min_score": 0.5 },
        "detectors": [{ "id": "cn_id_card", "description": "cn id", "type": "pattern", "pattern": "[1-9][0-9]{5}(19|20)[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx]", "validator": "cn_id_checksum", "score": 0.95 }],
        "operators": [{ "id": "default", "type": "redact" }]
      },
      "expected_output": "id [REDACTED] ok",
      "expected_matches": [{ "entity": "cn_id_card", "operator": "redact" }]
    },
    {
      "id": "aws_key_redact",
      "description": "AWS Access Key ID 脱敏",
      "input": "key AKIAIOSFODNN7EXAMPLE end",
      "key": "",
      "ruleset": {
        "version": 1, "rules_version": "golden.1",
        "defaults": { "action": "redact", "censor": "[REDACTED]", "min_score": 0.5 },
        "detectors": [{ "id": "aws_access_key", "description": "aws", "type": "pattern", "pattern": "(AKIA|ASIA)[0-9A-Z]{16}", "score": 0.95 }],
        "operators": [{ "id": "default", "type": "redact" }]
      },
      "expected_output": "key [REDACTED] end",
      "expected_matches": [{ "entity": "aws_access_key", "operator": "redact" }]
    }
  ]
}
